<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.next-up" path="/org/gnome/shell/extensions/next-up/">
    <!-- See also: https://docs.gtk.org/glib/gvariant-format-strings.html -->
    <key name="which-panel" type="i">
      <default>1</default>
    </key>
    <key name="look-ahead-minutes" type="i">
      <range min="0" max="1440"/>
      <default>0</default>
      <summary>Look-ahead window in minutes</summary>
      <description>Only show events starting within this many minutes from now. 0 shows all of today's events.</description>
    </key>
  </schema>
</schemalist>